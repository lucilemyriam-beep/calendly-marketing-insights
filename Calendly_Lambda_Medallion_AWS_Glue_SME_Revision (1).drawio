<mxfile host="app.diagrams.net" modified="2026-11-05T18:30:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="calendly-lambda-medallion" name="Calendly Lambda + Medallion"><mxGraphModel dx="1700" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="CALENDLY MARKETING INSIGHTS  |  AWS GLUE + MEDALLION ARCHITECTURE  |  REVISED SME REVIEW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#123457;strokeColor=#123457;fontColor=#172338;fontSize=23;fontFamily=Arial;align=center;verticalAlign=middle;spacing=8;strokeWidth=1.6;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1690" height="58" as="geometry"/></mxCell><mxCell id="subtitle" value="Selected PDF option 1 (revised per SME feedback): Calendly → Webhook → Delta Lake on Amazon S3 → AWS Glue / Apache Spark → Serving / Data Warehouse → Streamlit; marketing spend JSON joins downstream." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f1f9;strokeColor=#9ab5cf;fontColor=#172338;fontSize=15;fontFamily=Arial;align=center;verticalAlign=middle;spacing=8;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="50" y="92" width="1690" height="45" as="geometry"/></mxCell><mxCell id="speed_lane" value="SPEED / EVENT INGESTION PATH  (near-real-time capture)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dceefd;strokeColor=#83b9e9;fontColor=#172338;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;spacing=8;strokeWidth=1.6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="155" width="1690" height="48" as="geometry"/></mxCell><mxCell id="cal" value="Calendly&lt;br&gt;&lt;b&gt;invitee.created&lt;/b&gt;&lt;br&gt;Webhook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ecff;strokeColor=#5099d6;fontColor=#172338;fontSize=15;fontFamily=Arial;align=center;vertical